\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {MSTNet architecture.} Each STNet trunk $i\in \{s,c\}$ maps a SITS $\mathbf  {X}_i$ of length $T_i$ through a shared per-timestep MLP to $\mathbf  {E}_i$, adds DoY encodings to form $\mathbf  {E}_i'$, applies a Transformer encoder to obtain $\mathbf  {O}_i$, and pools with Seq2Vec to $\mathbf  {o}_s$ with NDVI weights or $\mathbf  {o}_c$ as a mean over valid days. The output head concatenates $\mathbf  {o}_s$, $\mathbf  {o}_c$, and MapBiomas Solo features~$\mathbf  {s}$, then $MLP_2$ predicts productivity~$\hat  {y}$. Adapted from Fig.~2 of~\citet  {xu2024sitsmoco}.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:mstnet-arch}{{2}{5}{\textbf {MSTNet architecture.} Each STNet trunk $i\in \{s,c\}$ maps a SITS $\mathbf {X}_i$ of length $T_i$ through a shared per-timestep MLP to $\mathbf {E}_i$, adds DoY encodings to form $\mathbf {E}_i'$, applies a Transformer encoder to obtain $\mathbf {O}_i$, and pools with Seq2Vec to $\mathbf {o}_s$ with NDVI weights or $\mathbf {o}_c$ as a mean over valid days. The output head concatenates $\mathbf {o}_s$, $\mathbf {o}_c$, and MapBiomas Solo features~$\mathbf {s}$, then $MLP_2$ predicts productivity~$\hat {y}$. Adapted from Fig.~2 of~\citet {xu2024sitsmoco}}{figure.caption.3}{}}
\newlabel{eq:doy-pe}{{4}{6}{Sequential encoding}{equation.4}{}}
