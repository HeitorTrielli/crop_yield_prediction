# Copy to .env and adjust paths for your machine:
#   cp .env.example .env

# Root folder with season subdirs, e.g. ~/sits_moco_data/npy/2020-2021/4109401/4109401.npy
# For Paraná pixel training this is typically sits_moco_data/npy (or npy_muni_mean for municipal aggregate).
SITS_MOCO_DATAPATH=~/sits_moco_data/npy
